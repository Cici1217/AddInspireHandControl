+    def test_rtc_previous_actions_are_processed_and_forwarded_to_model(self, policy):
+        obs = _make_observation()
+        previous = {
+            key: np.full((1, 16, 1), index, dtype=np.float32)
+            for index, key in enumerate(ACTION_KEYS)
+        }
+        options = {
+            "rtc_previous_actions": previous,
+            "action_horizon": 16,
+            "rtc_overlap_steps": 8,
+            "rtc_frozen_steps": 2,
+            "rtc_ramp_rate": 1.0,
+        }
+        captured = []
+
+        def capture_processor(messages):
+            captured.append(messages[0]["content"])
+            return {}
+
+        policy.processor.side_effect = capture_processor
+        policy.collate_fn.side_effect = lambda _items: BatchFeature(data={"inputs": {}})
+
+        _action, info = policy.get_action(obs, options=options)
+
+        assert info["rtc_applied"] is True
+        assert len(captured) == 1
+        for key in ACTION_KEYS:
+            np.testing.assert_array_equal(captured[0].actions[key], previous[key][0])
+        forwarded = policy.model.get_action.call_args.kwargs["options"]
+        assert "rtc_previous_actions" not in forwarded
+        assert forwarded["rtc_overlap_steps"] == 8
